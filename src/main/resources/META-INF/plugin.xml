<idea-plugin>
    <id>team.segroup11.issue-review</id>
    <name>GitHub Issue Quality Review</name>
    <vendor>CS5351 Group 11</vendor>
    <description>Browse private GitHub issues with the selected IDE account. Review six evidence-linked checks, edit a project-local draft, and explicitly send it back to the same issue.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.tasks</depends>
    <depends>Git4Idea</depends>
    <depends>org.jetbrains.plugins.github</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Issue Review" anchor="bottom" factoryClass="team.segroup11.review.ReviewWindowFactory"/>
        <applicationConfigurable parentId="tools" id="team.segroup11.review.model"
            displayName="GitHub Issue 质量评审" instance="team.segroup11.review.model.ModelConfigurable"/>
        <tasks.contextProvider implementation="team.segroup11.review.state.ReviewContextProvider"/>
    </extensions>
</idea-plugin>
